# Copy to .env and fill in real values. .env is git-ignored and must never be committed.

# --- LLM Provider Settings (Ollama by default, or OpenAI / LiteLLM proxy) ---
# Default provider: "ollama" or "openai" / "litellm" (auto-detected if OPENAI_BASE_URL is set)
# LLM_PROVIDER=ollama

# Ollama local settings
OLLAMA_MODEL=glm-5.2:cloud
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_EMBED_MODEL=nomic-embed-text

# OpenAI / LiteLLM proxy settings (uncomment to route calls through LiteLLM)
# OPENAI_BASE_URL=http://localhost:8081/v1
# OPENAI_API_KEY=sk-admin
# OPENAI_MODEL=deepseek-v4-flash:cloud

# --- Tool & Agent Keys ---
TAVILY_API_KEY=your_tavily_api_key_here

# --- MCP (Model Context Protocol) Server for RAG Chatbot ---
# Curated in-repo notes served to the RAG agent via md-mcp.
# MD_MCP_FOLDER=H:/code/yl/langgraph_ollama/demo-notes
# Long-lived md-mcp HTTP server (Streamable-http + traceparent propagation).
# MD_MCP_URL=http://localhost:8000/mcp

# --- Observability (OpenTelemetry / LGTM Stack) ---
# OTLP collector endpoint (Grafana/Loki/Tempo/Prometheus stack from docker-compose).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- Coding Engineer Agent (coding_agent/) ---
# Optional overrides for dual-model architecture (Primary = Maker, Secondary = Judge/Reviewer).
# Defaults to OLLAMA_* (or OPENAI_*) settings above if unset.
# CODING_AGENT_PRIMARY_PROVIDER=ollama
# CODING_AGENT_PRIMARY_MODEL=glm-5.2:cloud
# CODING_AGENT_PRIMARY_BASE_URL=http://localhost:11434
# CODING_AGENT_SECONDARY_PROVIDER=ollama
# CODING_AGENT_SECONDARY_MODEL=qwen3.5:cloud
# CODING_AGENT_SECONDARY_BASE_URL=http://localhost:11434
# CODING_AGENT_HITL_BDD_APPROVAL=false
# CODING_AGENT_ALLOW_INSTALL=false
