    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "langgraph_agent_example.py",
            "console": "integratedTerminal",
            // "python": "${workspaceFolder}/venv/Scripts/python",
            // "env": {
            //     "PYTHONPATH": "D:/code/amazon-bedrock-custom-langchain-agent"
            // }
        },
        {
            "name": "Python:Streamlit",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "app.py",
                "--server.port",
                "8515"
            ]
            // "program": "${file}",
            // "console": "integratedTerminal",
            // "justMyCode": true
        },
        {
            "name": "Debug evals.runner selftest",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/evals/runner.py",
            "args": [
                "--selftest",
                "--keep"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Debug evals.runner real test",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/evals/runner.py",
            "args": [
                "--tasks",
                "bug-001",
                "--keep"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}